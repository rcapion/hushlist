# Copy to .env and fill in. Never commit .env: it holds the auth key.

# An auth key: Tailscale admin console → Settings → Keys → Generate auth key.
# Reusable: no. Ephemeral: no (the node must survive restarts). Pre-approved
# if your tailnet requires device approval.
TS_AUTHKEY=

# The machine name in the tailnet. The address becomes
# https://<TS_HOSTNAME>.<your tailnet>.ts.net
TS_HOSTNAME=wishes

# The same address, written out (find your tailnet name in the admin console
# under DNS). Optional, but set it: links and cookies are then right.
HUSHLIST_PUBLIC_URL=https://wishes.your-tailnet.ts.net

# The household's language until an adult picks one under Settings: en or da.
HUSHLIST_LANGUAGE=en

# Optional (docs/CONFIGURATION.md)
# HUSHLIST_TIMEZONE=Europe/Copenhagen
# HUSHLIST_LINK_CHECK=off
# HUSHLIST_DATA=./data
