# Copy to .env and fill in. Never commit .env: it holds the tunnel token.

# The tunnel's token: Cloudflare dashboard → Networking → Tunnels → your
# tunnel → Overview: the Docker command shows it after "--token".
TUNNEL_TOKEN=

# The address the family will use. Optional, but set it: links and cookies
# are then right however the proxy behaves.
HUSHLIST_PUBLIC_URL=https://wishes.example.com

# The household's language until an adult picks one under Settings: en or da.
HUSHLIST_LANGUAGE=en

# Optional (docs/CONFIGURATION.md)
# HUSHLIST_TIMEZONE=Europe/Copenhagen
# HUSHLIST_LINK_CHECK=off
# HUSHLIST_DATA=./data
